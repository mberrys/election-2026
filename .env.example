# Upstash Redis (Vercel Marketplace → "Upstash for Redis" creates these automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Legacy Vercel KV names also accepted
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/ingest. External schedulers must send the same header.
CRON_SECRET=

# OpenFEC key (api.data.gov). DEMO_KEY works for the build script at ~30 req/hr.
FEC_API_KEY=DEMO_KEY

# Georgia Enhanced Voting election slug for Nov 3 2026 (auto-discovered when empty)
GA_ELECTION_SLUG=

# Private cross-check feed. NOT a product data source (NYT ToS forbids scraping/redistribution). Default off.
ENABLE_NYT_XCHECK=0

# Ingest cadence: how many upstream pulls per cron invocation and the gap between them (Pro cron is 1/min)
INGEST_PULLS_PER_RUN=2
INGEST_PULL_GAP_MS=30000

# Public base URL (for absolute links / OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bearer token for POST /api/annotations (election-night litigation / count-paused / set-aside notes)
ADMIN_SECRET=

# Rehearsal only. SIM_SCENARIO=contested adds a razor-thin AK Senate with a namesake spoiler and a seized county.
SIMULATE=0
SIM_SPEED=30
SIM_SCENARIO=
